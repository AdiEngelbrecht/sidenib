{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sidenib",
  "version": "0.2.0",
  "identifier": "io.github.adiengelbrecht.sidenib",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173/?runtime=tauri",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sidenib",
        "width": 28,
        "height": 72,
        "visible": false,
        "acceptFirstMouse": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "transparent": true,
        "shadow": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Adi Engelbrecht",
    "copyright": "Copyright 2026 Adi Engelbrecht. Based on Todobar, Copyright 2026 Leonxlnx. Apache-2.0.",
    "category": "Productivity",
    "shortDescription": "A small task companion at the screen edge.",
    "homepage": "https://github.com/AdiEngelbrecht/sidenib",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
